{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/prepaid-cod",
      "destination": "/services/pay-on-delivery-courier-kenya",
      "permanent": true
    },
    {
      "source": "/instant-settlements",
      "destination": "/services/pay-on-delivery-courier-kenya",
      "permanent": true
    },
    {
      "source": "/notifications",
      "destination": "/services/pay-on-delivery-courier-kenya",
      "permanent": true
    },
    {
      "source": "/pickup-agent",
      "destination": "/opportunities?role=pickup",
      "permanent": true
    },
    {
      "source": "/booking-agent",
      "destination": "/opportunities?role=booking",
      "permanent": true
    },
    {
      "source": "/apply-pickup-agent",
      "destination": "/opportunities?role=pickup",
      "permanent": true
    },
    {
      "source": "/apply-booking-agent",
      "destination": "/opportunities?role=booking",
      "permanent": true
    },
    {
      "source": "/track-parcel",
      "destination": "/track",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
